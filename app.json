{
  "expo": {
    "name": "SHEPHERD",
    "slug": "bible-notes-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121316"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biblenotes.app",
      "icon": "./assets/icon.png",
      "splash": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#121316"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.biblenotes.app"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification",
          "processing"
        ]
      }
    },
    "android": {
      "package": "com.biblenotes.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#121316"
      },
      "splash": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#121316"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/withVerseWidget",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E5A93C",
          "sounds": [
            "./assets/classic_phone_bell.wav",
            "./assets/digital_alarm_beeps.wav",
            "./assets/modern_marimba.wav",
            "./assets/spiritual_chimes.wav",
            "./assets/radiant_sunrise_bell.wav",
            "./assets/gospel_fanfare.wav",
            "./assets/cathedral_bells.wav",
            "./assets/morning_harp.wav",
            "./assets/peaceful_piano.wav",
            "./assets/spiritual_alarm.wav"
          ]
        }
      ]
    ],
    "scheme": "biblenotes",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d114ae6d-f5d2-4524-972a-19c47d0933b0"
      }
    }
  }
}
