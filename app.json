{
  "expo": {
    "name": "SHEPHERD",
    "slug": "bible-notes-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biblenotes.app",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.biblenotes.app"]
      }
    },
    "android": {
      "package": "com.biblenotes.app"
    },
    "plugins": [
      "expo-router",
      "./plugins/withVerseWidget"
    ],
    "scheme": "biblenotes"
  }
}
